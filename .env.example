# پورت سرور (پیش‌فرض 3000)
PORT=3000

# آدرس شنود — برای پیش‌نمایش/شبکه‌ی داخلی 0.0.0.0 بگذارید
HOST=0.0.0.0

# مسیر ذخیره‌ی داده‌ها (پیش‌فرض: ./data)
# PAYROLL_DATA_DIR=/var/lib/hoghooghyar

# رمز پنل (جایگزین تنظیمات داخل برنامه؛ اگر خالی باشد از مقدار ذخیره‌شده در db استفاده می‌شود)
# PANEL_PASSWORD=یک-رمز-قوی

# توکن ربات بله (جایگزین ورود توکن در تنظیمات برنامه)
# BALE_BOT_TOKEN=123456789:AA...

# آدرس پایه‌ی API بله (در صورت استفاده از درگاه واسط تغییر دهید)
# BALE_API_BASE=https://tapi.bale.ai

# منشأهای مجاز برای CORS؛ پیش‌فرض * (برای اپ اندروید لازم است)
# CORS_ORIGIN=https://app.example.com,https://localhost
